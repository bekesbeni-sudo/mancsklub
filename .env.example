# Supabase connection string (transaction pooler). Leave empty to use the local database.
DATABASE_URL=
# "true" opens the forms. In production they also need site.controller to be filled in.
FORMS_OPEN=false
# Password for /admin/export/waitlist and /admin/export/clinics (any username).
ADMIN_EXPORT_PASSWORD=
# Leave empty to skip the confirmation email.
RESEND_API_KEY=
# Password for the admin login (username: admin). Use a long, new one in production.
ADMIN_PASSWORD=
# Signs login sessions. At least 32 random characters.
SESSION_SECRET=
